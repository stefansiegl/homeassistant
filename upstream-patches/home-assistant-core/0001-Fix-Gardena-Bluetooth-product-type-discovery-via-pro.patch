 from habluetooth import BluetoothServiceInfoBleak
 
 from homeassistant.components import bluetooth
@@ -36,6 +37,36 @@ DISCONNECT_DELAY = 5
 PRODUCTS_SCAN_TIMEOUT = 10
 PRODUCT_TYPE_TIMEOUT = 30
 
+_PROBE_PRODUCT_TYPES = (
+    ProductType.VALVE,
+    ProductType.WATER_COMPUTER,
+    ProductType.PUMP,
+    ProductType.PRESSURE_TANKS,
+    ProductType.AUTOMATS,
+    ProductType.AQUA_CONTOURS,
+)
+
+_PROBE_CHARACTERISTICS = {
+    ProductType.VALVE: Valve.state,
+}
+
+
+def _probe_characteristic(product_type: ProductType) -> Characteristic | None:
+    if characteristic := _PROBE_CHARACTERISTICS.get(product_type):
+        return characteristic
+    services = Service.services_for_product_type(product_type)
+    if not services:
+        return None
+    return next(iter(services[0].characteristics.values()), None)
+
+
+def _update_manufacturer_data(
+    data: ManufacturerData, info: BluetoothServiceInfoBleak
+) -> None:
+    raw = info.manufacturer_data.get(ManufacturerData.company, b"")
+    if raw:
+        data.update(raw)
+
 
 async def async_get_product(hass: HomeAssistant, address: str) -> ManufacturerData:
     """Get manufacturer data for the given address via active scan."""
@@ -46,8 +77,7 @@ async def async_get_product(hass: HomeAssistant, address: str) -> ManufacturerDa
         LOGGER.debug("Processing advertisement from %s: %s", info.address, info)
         if info.device.address != address:
             return False
-
-        data.update(info.manufacturer_data.get(ManufacturerData.company, b""))
+        _update_manufacturer_data(data, info)
         return data.product_type is not ProductType.UNKNOWN
 
     with suppress(TimeoutError):
@@ -55,7 +85,23 @@ async def async_get_product(hass: HomeAssistant, address: str) -> ManufacturerDa
             hass,
             _data_callback,
             bluetooth.BluetoothCallbackMatcher(
-                address=address, manufacturer_id=ManufacturerData.company
+                address=address,
+                service_uuid=ScanService,
+            ),
+            mode=bluetooth.BluetoothScanningMode.ACTIVE,
+            timeout=PRODUCT_TYPE_TIMEOUT,
+        )
+
+    if data.product_type is not ProductType.UNKNOWN:
+        return data
+
+    with suppress(TimeoutError):
+        await bluetooth.async_process_advertisements(
+            hass,
+            _data_callback,
+            bluetooth.BluetoothCallbackMatcher(
+                address=address,
+                manufacturer_id=ManufacturerData.company,
             ),
             mode=bluetooth.BluetoothScanningMode.ACTIVE,
             timeout=PRODUCT_TYPE_TIMEOUT,
@@ -72,37 +118,75 @@ async def async_get_products(hass: HomeAssistant) -> dict[str, ManufacturerData]
         if ScanService not in info.service_uuids:
             return False
 
-        raw = info.manufacturer_data.get(ManufacturerData.company, b"")
         if (data := products.get(info.device.address)) is None:
             data = ManufacturerData()
             products[info.device.address] = data
 
-        data.update(raw)
+        _update_manufacturer_data(data, info)
         return False
 
     with suppress(TimeoutError):
         await bluetooth.async_process_advertisements(
             hass,
             _data_callback,
-            bluetooth.BluetoothCallbackMatcher(
-                manufacturer_id=ManufacturerData.company
-            ),
+            bluetooth.BluetoothCallbackMatcher(service_uuid=ScanService),
             mode=bluetooth.BluetoothScanningMode.ACTIVE,
             timeout=PRODUCTS_SCAN_TIMEOUT,
         )
     return products
 
 
+async def async_probe_product_type(
+    hass: HomeAssistant, address: str
+) -> ProductType:
+    """Determine product type by connecting when advertisements are incomplete."""
+    connection = get_connection(hass, address)
+
+    for product_type in _PROBE_PRODUCT_TYPES:
+        client = Client(connection, product_type)
+        characteristic = _probe_characteristic(product_type)
+        if characteristic is None:
+            continue
+        try:
+            await client.read_char(characteristic)
+            LOGGER.info(
+                "Probed Gardena product type %s for %s via BLE connection",
+                product_type.name,
+                address,
+            )
+            return product_type
+        except (CharacteristicNotFound, CommunicationFailure, DeviceUnavailable):
+            LOGGER.debug(
+                "Probe for %s on %s did not match",
+                product_type.name,
+                address,
+            )
+        finally:
+            await client.disconnect()
+
+    return ProductType.UNKNOWN
+
+
+async def async_resolve_product_type(
+    hass: HomeAssistant, address: str
+) -> ProductType:
+    """Resolve product type from advertisements, falling back to connection probe."""
+    mfg = await async_get_product(hass, address)
+    if mfg.product_type is not ProductType.UNKNOWN:
+        return mfg.product_type
+    return await async_probe_product_type(hass, address)
+
+
 async def async_migrate_product_type(
     hass: HomeAssistant, entry: GardenaBluetoothConfigEntry
 ) -> GardenaBluetoothConfigEntry:
     """Discover product type for old entries and upgrade them to minor version 2."""
-    mfg = await async_get_product(hass, entry.data[CONF_ADDRESS])
-    if mfg.product_type is ProductType.UNKNOWN:
+    product_type = await async_resolve_product_type(hass, entry.data[CONF_ADDRESS])
+    if product_type is ProductType.UNKNOWN:
         raise ConfigEntryNotReady("Unable to find product type")
     hass.config_entries.async_update_entry(
         entry,
-        data={**entry.data, CONF_PRODUCT_TYPE: mfg.product_type.name},
+        data={**entry.data, CONF_PRODUCT_TYPE: product_type.name},
         minor_version=2,
     )
     return entry
